{
  "name": "x-learning-feed-mcp",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && npm run build:extension && npm run build:plugin && tsc -p tsconfig.tests.json && node --test tests/*.test.mjs",
    "build:extension": "wxt build",
    "check:extension": "wxt prepare && tsc --noEmit -p tsconfig.extension.json",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:plugin": "tsc -p tsconfig.plugin.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.16",
    "marked": "^17.0.0",
    "sanitize-html": "^2.17.0",
    "wxt": "^0.21.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "js-yaml": "^5.4.3",
    "jsdom": "^30.1.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
